pipeline {
    agent {
        docker {
            image 'node:20-alpine'
            args '-u root'
        }
    }
    stages {

        stage('checkout and install dependencies') {
              checkout scm
              dir('Node_jenkins_docker-app') {
                sh 'apt-get update -y && apt-get install -y npm'
              }
        }
        stage('Build') {
            sh 'cd Node_jenkins_docker-app && npm install'
        }
        stage('Test') {
            sh 'cd Node_jenkins_docker-app && npm test'
        }
        stage('Deploy') {
            sh 'cd Node_jenkins_docker-app && node app.js &'
        }
        stage('Build Docker Image') {
            sh 'cd Node_jenkins_docker-app && docker build -t node-jenkins-docker-app .'
        }
        stage('Push Docker Image') {
            withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'dockerhubuser', passwordVariable: 'dockerhubpass')]) {
                sh 'echo $dockerhubpass | docker login -u $dockerhubuser --password-stdin'
                sh 'docker tag node-jenkins-docker-app $dockerhubuser/node-jenkins-docker-app:latest'
                sh 'docker push $dockerhubuser/node-jenkins-docker-app:latest'
            }
        }
    }
}
