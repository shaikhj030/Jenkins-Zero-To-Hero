pipeline {
    agent any 
    stages {
        stage('Build python images') {
            steps {
               dir('my-first-pipeline') {
                    sh 'docker build -t python-app:latest .' 
               }
            }
        }
        stage('Run Python App') {
            steps {
                    dir('my-first-pipeline') {
                    // Runs the container, mounts the workspace, and executes the app
                    sh 'docker run --rm -v $(pwd):/app -w /app python-app:latest python app.py'
                }
            }
        }
    }
}
