pipeline {
  agent any // Runs the pipeline workspace on the local Jenkins server
  stages {
    stage('Build and test') {
        agent {
            dockerContainer { 
              image 'node:16-alpine'
              // Reuses the existing workspace on the host machine
            }
        }
    }
  }
  stages {
      stage('Test') {
         steps {
              sh 'node --version'
         }
      }
  }
}
