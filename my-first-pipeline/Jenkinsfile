pipeline {
  agent any // Runs the pipeline workspace on the local Jenkins server
  stages {
    stage('Build and test') {
        agent {
            dockerContainer { 
              image 'python-app:latest'
              // Reuses the existing workspace on the host machine
              args '-t -i'
            }
        }
        steps {
          // Add your build commands here
                sh 'echo "python docker running"'
        }
    }
    stage('Test') {
        steps {
              sh 'python3 --version'
        }
    }
  }
}
